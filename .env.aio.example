# ─── Tessio all-in-one ───────────────────────────────────────────────────────
# cp .env.aio.example .env  (docker compose -f compose.aio.yaml auto-loads .env)
TESSIO_VERSION=latest

# Datastores (default to the bundled postgres/redis services in compose.aio.yaml).
POSTGRES_PASSWORD=tessio
# To use a managed Postgres/Redis instead, set these and remove the postgres/redis
# services (the Postgres must have the pgvector extension available):
# DATABASE_URL=postgres://user:pass@host:5432/db
# REDIS_URL=redis://host:6379

# Secrets (REQUIRED — generate fresh):
#   SESSION_SECRET:   openssl rand -base64 48
#   TESSIO_SECRET_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TESSIO_SECRET_KEY=

# First admin (optional; seeds on first start):
TESSIO_ADMIN_EMAIL=
TESSIO_ADMIN_PASSWORD=
TESSIO_ADMIN_NAME=

# Public address (":80" plain HTTP). Put a TLS-terminating proxy in front for HTTPS.
TESSIO_SITE_ADDRESS=:80
TESSIO_HTTP_PORT=80
